{
  "version": 1,
  "id": "chrome-3d-carousel",
  "name": "Chrome 3D Carousel",
  "project": "Personal",
  "format": "custom",
  "renderer": "ChromeCarousel",
  "canvas": {
    "width": 1170,
    "height": 1316,
    "fps": 60,
    "duration": 9.3
  },
  "chromeCarousel": {
    "slideCount": 4,
    "slideDuration": 2.325,
    "transitionDuration": 0.55,
    "perspective": 1500,
    "rotateY": 72,
    "translateX": 1
  },
  "sampleData": {
    "slideDuration": 2.325,
    "transitionDuration": 0.55,
    "slides": [
      {
        "title": "Mary's",
        "subtitle": "Chrome",
        "background": "#f5dfe2",
        "image": "/assets/chrome-carousel/slide-1.jpg"
      },
      {
        "title": "El Chrome",
        "subtitle": "de Diana",
        "background": "#fbf4d7",
        "image": "/assets/chrome-carousel/slide-2.jpg"
      },
      {
        "title": "Il Chrome",
        "subtitle": "di Vittorio",
        "background": "#dff0e9",
        "image": "/assets/chrome-carousel/slide-3.jpg"
      },
      {
        "title": "June's",
        "subtitle": "Chrome",
        "background": "#dceafa",
        "image": "/assets/chrome-carousel/slide-4.jpg"
      }
    ]
  },
  "background": {
    "color": "#f5dfe2"
  },
  "elements": [
    {
      "id": "slide-1-artwork",
      "name": "Slide 1 Artwork",
      "type": "image",
      "role": "slide-artwork",
      "slide": 0,
      "x": 0,
      "y": 0,
      "width": 1170,
      "height": 1316,
      "zIndex": 1,
      "src": "/assets/chrome-carousel/slide-1.jpg",
      "objectFit": "cover",
      "start": 0,
      "end": 2.325,
      "animation": { "type": "carousel", "duration": 0.55, "easing": "easeInOut" }
    },
    {
      "id": "slide-2-artwork",
      "name": "Slide 2 Artwork",
      "type": "image",
