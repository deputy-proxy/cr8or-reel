{
  "version": 2,
  "id": "lightfall-promo",
  "name": "Lightfall Promo",
  "project": "Personal",
  "format": "reel",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "duration": 8
  },
  "background": {
    "type": "lightfall",
    "props": {
      "color1": "#1d4ed8",
      "color2": "#F97316",
      "color3": "#EF4444",
      "backgroundColor": "#ffffff",
      "speed": 0.5,
      "streakCount": 4,
      "streakWidth": 1.15,
      "streakLength": 1,
      "glow": 1.15,
      "density": 0.6,
      "twinkle": 1,
      "zoom": 3,
      "backgroundGlow": 0,
      "opacity": 1,
      "mouseInteraction": false,
      "mouseStrength": 0.5,
      "mouseRadius": 1,
      "lightMode": true
    }
  },
  "sampleData": {
    "headline": "CREATE AMAZING SHORT VIDEOS",
    "subheadline": "Ideas \u2192 Content \u2192 Impact",
    "eyebrow": "BUILT FOR CREATORS",
    "buttonText": "START CREATING"
  },
  "elements": [
    {
      "id": "eyebrow",
      "name": "Eyebrow",
      "type": "text",
      "text": "{{eyebrow}}",
      "x": 90,
      "y": 160,
      "width": 900,
      "height": 70,
      "zIndex": 10,
      "color": "#111827",
      "fontSize": 32,
      "fontWeight": 700,
      "fontFamily": "Arial, Helvetica, sans-serif",
      "letterSpacing": 8,
      "textAlign": "center",
      "start": 0,
      "end": 8,
      "animation": {
        "type": "fadeIn",
        "duration": 0.6
      }
    },
    {
      "id": "headline",
      "name": "Headline",
      "type": "text",
      "text": "{{headline}}",
      "x": 70,
      "y": 360,
      "width": 940,
      "height": 330,
      "zIndex": 10,
      "color": "#111827",
      "fontSize": 104,
      "fontWeight": 900,
      "fontFamily": "Arial, Helvetica, sans-serif",
      "lineHeight": 0.95,
      "textAlign": "center",
      "start": 0,
      "end": 8,
      "animation": {
        "type": "slideInUp",
        "duration": 0.8
      }
    },
    {
      "id": "subheadline",
      "name": "Subheadline",
      "type": "text",
      "text": "{{subheadline}}",
      "x": 100,
      "y": 760,
      "width": 880,
      "height": 100,
      "zIndex": 10,
      "color": "#111827",
      "fontSize": 42,
      "fontWeight": 600,
      "fontFamily": "Arial, Helvetica, sans-serif",
      "letterSpacing": 4,
      "textAlign": "center",
      "start": 0.35,
      "end": 8,
      "animation": {
        "type": "fadeIn",
        "duration": 0.7
      }
    },
    {
      "id": "button",
      "name": "CTA",
      "type": "button",
      "text": "{{buttonText}}",
      "x": 250,
      "y": 1600,
      "width": 580,
      "height": 110,
      "zIndex": 10,
      "background": "#111827",
      "color": "#ffffff",
      "fontSize": 34,
      "fontWeight": 800,
      "fontFamily": "Arial, Helvetica, sans-serif",
      "borderRadius": 55,
      "textAlign": "center",
      "alignItems": "center",
      "justifyContent": "center",
      "start": 1,
      "end": 8,
      "animation": {
        "type": "springIn",
        "duration": 0.8
      }
    }
  ],
  "animations": {
    "custom": []
  }
}
